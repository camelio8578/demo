# Database
DATABASE_URL=postgresql://clipos:clipos_dev_password@localhost:5432/clipos
POSTGRES_PASSWORD=clipos_dev_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
DATA_DIR=/data

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Whisper
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large-v3
# tiny/base: fast, good for dev. medium/large: production quality

# LLM (optional — system works without these)
LLM_PROVIDER=none
# Options: none, openai, anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube (optional — publishing requires these)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok (optional — publishing requires these + Developer App approval)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram/Meta (optional — publishing requires these + Meta App Review)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# AWS S3 / MinIO (optional — local filesystem used by default)
USE_S3=false
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=clipos-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Admin
ADMIN_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pipeline settings
AUTO_RENDER_TOP_N=5
AUTO_RENDER_ENABLED=false
MIN_CLIP_DURATION=30
MAX_CLIP_DURATION=120
CLIP_PADDING_SECONDS=1.5
SCORING_VERSION=1.0
MAX_CANDIDATES_PER_VIDEO=10

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

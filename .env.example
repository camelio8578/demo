# Proceeds Navigator — Environment Variables
# Copy to .env and fill in all values before running.
# Never commit .env to git.
# WARNING: Do not put inline comments after values (they become part of the value).

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for v1):
DATABASE_URL=sqlite:///./data/proceeds_navigator.db
# PostgreSQL upgrade path (uncomment and fill to switch):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proceeds_navigator

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── Runtime Directories ───────────────────────────────────────────────────────
DATA_DIR=./data
SNAPSHOTS_DIR=./data/snapshots
EXPORTS_DIR=./data/exports

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Scraper Behavior ─────────────────────────────────────────────────────────
SCRAPE_DELAY_SECONDS=2
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
PLAYWRIGHT_HEADLESS=true
HTTP_USER_AGENT=Mozilla/5.0 (compatible; GoldenStateClaimantAdvisors-Research/1.0)

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Dashboard ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Operator Identity (used in document templates) ────────────────────────────
OPERATOR_NAME=Golden State Claimant Advisors
OPERATOR_ADDRESS=
OPERATOR_PHONE=
OPERATOR_EMAIL=
OPERATOR_WEBSITE=

# ── Lead Scoring Thresholds ───────────────────────────────────────────────────
SCORE_HIGH_PRIORITY_MIN=70
LEGAL_REVIEW_AMOUNT_THRESHOLD=50000

# ── County URL Overrides (optional — defaults come from config/counties.yaml) ─
# FRESNO_SCRAPE_URL=
# SAN_DIEGO_SCRAPE_URL=
# SACRAMENTO_SCRAPE_URL=
# LOS_ANGELES_SCRAPE_URL=
